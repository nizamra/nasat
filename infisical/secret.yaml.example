# DO NOT commit this file to git with real values filled in.
#
# This is "secret zero" for your whole secrets-management story: Infisical needs
# these to even start, so they can't live inside Infisical itself. Generate them
# once, then either:
#       apply this manifest directly with kubectl and keep this file in git as a
#       placeholder template only (add a local, gitignored copy with real values
#       for your own re-application), or
#
# Generate real values with:
#   ENCRYPTION_KEY=$(openssl rand -hex 16)
#   AUTH_SECRET=$(openssl rand -base64 32)
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)
#
# DB_CONNECTION_URI must be: postgres://infisical:<POSTGRES_PASSWORD>@postgres.infisical.svc.cluster.local:5432/infisical
apiVersion: v1
kind: Secret
metadata:
  name: infisical-secrets
  namespace: infisical
type: Opaque
stringData:
  ENCRYPTION_KEY: "REPLACE_WITH_openssl_rand_-hex_16"
  AUTH_SECRET: "REPLACE_WITH_openssl_rand_-base64_32"
  POSTGRES_PASSWORD: "REPLACE_WITH_A_STRONG_PASSWORD"
  DB_CONNECTION_URI: "postgres://infisical:REPLACE_WITH_A_STRONG_PASSWORD@postgres.infisical.svc.cluster.local:5432/infisical"
